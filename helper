#! /bin/bash

#sudo apt install cmake build-essential git pkg-config

CheckTerminalApp() {
  echo "Checking terminal application: $TERMINAL_TARGET"
  if [ "$(apt list "$TERMINAL_TARGET" 2>/dev/null | grep -i "$TERMINAL_TARGET/stable")" == "" ]; then
    echo "$TERMINAL_TARGET is not installed"
    echo "should $TERMINAL_TARGET be installed automatically? (y/n)"
    read -r INSTALL_TERMINAL
    if [ "$INSTALL_TERMINAL" == "y" ]; then
      sudo apt install "$TERMINAL_TARGET"
    else
      echo "$TERMINAL_TARGET will not be installed"
      exit 1
    fi
  fi
}

installServer() {
  echo "Installing server script "
  ./scripts/install_server
  echo "Server installation script complete."
}

installClient() {
  echo "Installing client script"
  ./scripts/install_client
  echo "Client installation script complete."
}

installScanner() {
  echo "Installing scanner script"
  ./scripts/install_scanner
  echo "Scanner installation script complete."
}

cleanup() {
  echo "Cleaning up environment script"
  ./scripts/cleanup
  echo "Environment cleanup script complete."
}

setup() {
  echo "Setting up environment script"
  ./scripts/setup
  echo "Environment script setup complete."
}

startServer() {
  echo "Starting server..."
  ./scripts/start_server
  echo "Server stopped."
}

startClient() {
  echo "Starting client script"
  ./scripts/start_client
  echo "Client script stopped."
}

startScanner() {
  echo "Starting scanner script"
  ./scripts/start_scanner
  echo "Scanner script stopped."
}

RUN_IN_NEW_TERMINAL=0
TERMINAL_TARGET=konsole
ERROR=0

echo starting

while [ "$#" -gt 0 ]
  do
    case "$1" in
      --start_server)
        echo "Starting server..."
        if [ "$RUN_IN_NEW_TERMINAL" -eq 0 ]; then
          echo "Running server in current terminal..."
          startServer
        else
        echo "Running server in new terminal..."
          $TERMINAL_TARGET -e /bin/bash -c "cd $PWD; ./helper --start_server" &
        fi
        ;;
      --start_client)
        echo "Starting client..."
        if [ "$RUN_IN_NEW_TERMINAL" -eq 0 ]; then
          echo "Running client in current terminal..."
          startClient
        else
          echo "Running client in new terminal..."
          $TERMINAL_TARGET -e /bin/bash -c "cd $PWD; ./helper --start_client" &
        fi
        ;;
      --start_scanner)
        echo "Starting scanner..."
        if [ "$RUN_IN_NEW_TERMINAL" -eq 0 ]; then
          echo "Running scanner in current terminal..."
          startScanner
        else
          echo "Running scanner in new terminal..."
          $TERMINAL_TARGET -e /bin/bash -c "cd $PWD; ./helper --start_scanner" &
        fi
        ;;
      --set_terminal)
        echo "Setting terminal target..."
        if [ "$#" -lt 2 ]; then
          echo "--set_terminal requires a terminal name" >&2
          exit 1
        fi
        echo "Setting terminal target to $2"
        TERMINAL_TARGET="$2"
        CheckTerminalApp
        shift
        ;;
      --run_in_new_terminal)
        echo "new terminal mode activated"
        RUN_IN_NEW_TERMINAL=1
        ;;
      --*)
        echo "Unknown option: $1"
        ERROR=1
        ;;
    esac
  shift
done

echo done

exit $ERROR
