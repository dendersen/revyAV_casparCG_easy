#! /bin/bash
if [ "$PWD" != "$HOME/casparCG" ]; then
  OLD_PATH="$PWD"
  REPO=$(cat ./.git/config | grep 'url = ' | sed 's|url = ||' | sed 's| ||' | sed 's|\t||')
  #insure repo points to a revyAV_casparCG_easy.git
  if [[ "$REPO" != *"revyAV_casparCG_easy.git"* ]]; then
    echo "Error: Repository is not revyAV_casparCG_easy.git"
    exit 2
  fi
  echo "got path    '$REPO'"
  echo "expecting : 'https://github.com/dendersen/revyAV_casparCG_easy.git'"
  if [ "$REPO" != "" ]; then
    if git clone "$REPO" "$HOME/casparCG"; then
      echo "Repository cloned successfully."
    else
      echo "Error: Failed to clone repository."
      exit 1
    fi
  fi
  cd "$HOME/casparCG"
  #ask user for confirmation before removing old path
  read -p "Remove old path $OLD_PATH? (y/n) " CONFIRM
  if [[ "$CONFIRM" != "y" ]]; then
    exit 0
  fi
  rm -rf "$OLD_PATH"
fi
