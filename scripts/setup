#! bin/bash
mv server/casparcg.config .
ln -sf casparcg.config server/casparcg.config
ln -sf casparcg.config scanner/casparcg.config
sed -i "s#<media-path>media/</media-path>#<media-path>${PWD}/media/</media-path>#g" casparcg.config
sed -i "s#<log-path>log/</log-path>#<log-path>${PWD}/log/</log-path>#g" casparcg.config
sed -i "s#<log-path disable=\"false\">log/</log-path>#<log-path disable=\"false\">${PWD}/log/</log-path>#g" casparcg.config
sed -i "s#<data-path>data</data-path>#<data-path>${PWD}/data</data-path>#g" casparcg.config
sed -i "s#<template-path>template</template-path>#<template-path>${PWD}/template</template-path>#g" casparcg.config