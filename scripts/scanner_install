#! /bin/bash

if [ ! -d "media-scanner_src" ]; then
  git clone https://github.com/CasparCG/media-scanner.git media-scanner_src
fi

cd media-scanner_src/

yarnpkgInstallSecond() {
  curl -fsSL https://deb.nodesource.com/setup_24.x | sudo -E bash -
  sudo apt-get install -y nodejs
  sudo npm install -g corepack
  sudo corepack enable
}

if ! sudo apt update; then
  echo "Failed to update package list"
  exit 1
fi

YARN_GOOD=0
if ! command -v yarnpkg >/dev/null 2>&1; then
  echo "Yarnpkg is not installed"
else
  if yarnpkg --version | grep -q "^[4]"; then
    echo "Yarnpkg version 4 is installed"
    YARN_GOOD=1
  else
    echo "Yarnpkg too old"
    exit 1
  fi
fi

if [ "$YARN_GOOD" -eq 0 ]; then
  echo "Attempting to install Yarnpkg"
  if ! apt-cache madison yarnpkg | grep -q "yarnpkg | 4"; then
    echo "apt yarnpkg not version 4"
    echo "Installing Yarnpkg version 4 using alternative method"
    yarnpkgInstallSecond
    if yarnpkg --version | grep -q "^[4]"; then
      echo "Yarnpkg version 4 is installed"
      YARN_GOOD=1
    fi
  fi
else
  echo "Yarnpkg version 4 is already installed"
  echo "Skipping installation" 
fi

if [ "$YARN_GOOD" -eq 0 ]; then
  echo "installing Yarnpkg using apt"
  if ! sudo apt install -y yarnpkg; then
    echo "Failed to install yarnpkg using apt"
    exit 1
  fi
else
  echo "Yarnpkg version 4 is installed"
  echo "not attempting yarnpkg with apt"
fi

if ! sudo apt upgrade -y; then
  echo "Failed to upgrade packages"
  exit 1
fi

yarnpkg install
yarnpkg dev &
yarnpkg build

if [ ! -d "deploy" ]; then
  echo "Deploy directory not found"
  exit 1
fi

if [ -d "../scanner" ]; then
  echo "Scanner directory already exists"
  echo "do you wish to delete it first? (y/n)"
  read -r response
  if [ "$response" = "y" ]; then
    rm -rf ../scanner
  else
    echo "Aborting"
    exit 1
  fi
fi

mv deploy/ ../scanner
cd ..