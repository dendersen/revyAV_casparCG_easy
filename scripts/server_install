#! /bin/bash
git clone https://github.com/CasparCG/server.git server_src
cd server_src

if sudo apt update; then
  echo "Failed to update package list"
  exit 1
fi

if sudo tools/linux/build-in-docker; then
  echo "Failed to build in docker"
  exit 1
fi

if sudo tools/linux/extract-from-docker; then
  echo "Failed to extract from docker"
  exit 1
fi

if sudo apt upgrade -y; then
  echo "Failed to upgrade packages"
  exit 1
fi

sudo chown -r $USER:$USER casparcg_server/
mv casparcg_server/ ../server
cd ..